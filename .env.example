# Where the server listens
BIND=0.0.0.0:8080
# Public URL used to build the links that are handed back to clients
BASE_URL=http://localhost:8080

# HTTPS: set both to serve TLS directly (BIND=0.0.0.0:443 to listen on 443).
# Leave them unset to serve plain HTTP behind a reverse proxy.
# Remember to switch BASE_URL to https:// as well.
#TLS_CERT=/etc/openpaste/tls/fullchain.pem
#TLS_KEY=/etc/openpaste/tls/privkey.pem

# How often the PEM files are re-read, so a renewed certificate is picked up
# without a restart. 0 disables it.
#TLS_RELOAD_SECS=3600

# Extra plain-HTTP listener that 308s everything to BASE_URL. Needs TLS and an
# https:// BASE_URL.
#HTTP_REDIRECT_BIND=0.0.0.0:80

# sqlite://./data/openpaste.db?mode=rwc
# postgres://user:pass@localhost:5432/openpaste
DATABASE_URL=sqlite://./data/openpaste.db?mode=rwc

# Binary storage: "local" or "s3"
STORAGE_DRIVER=local
STORAGE_PATH=./data/blobs

# Only used when STORAGE_DRIVER=s3 (credentials come from the standard AWS_* vars)
#S3_BUCKET=my-bucket
#S3_PREFIX=openpaste
#AWS_REGION=us-east-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_ENDPOINT=https://s3.example.com   # for MinIO / R2 / other S3-compatible services

# Maximum upload size in bytes (default 100 MiB)
MAX_UPLOAD_BYTES=104857600

# API only, no web UI
HEADLESS=false

RUST_LOG=openpaste=info

# Image tag used by docker-compose: "latest", "dev" or a version like 0.2.0
OPENPASTE_VERSION=latest
