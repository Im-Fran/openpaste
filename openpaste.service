[Unit]
Description=openpaste
Documentation=https://github.com/Im-Fran/openpaste
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=openpaste
Group=openpaste
ExecStart=/usr/local/bin/openpaste serve
EnvironmentFile=/etc/openpaste/openpaste.env
WorkingDirectory=/var/lib/openpaste
StateDirectory=openpaste
Restart=on-failure
RestartSec=5s

# Needed only when BIND uses a privileged port (e.g. 0.0.0.0:443)
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/openpaste
# Certificates live outside the state dir; ProtectSystem=strict needs them allowed
ReadOnlyPaths=/etc/openpaste

[Install]
WantedBy=multi-user.target
